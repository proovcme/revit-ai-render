<Window x:Class="RevitAiRender.ConnectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Подключение AI Render" Width="520" MinWidth="440" MaxHeight="690" SizeToContent="Height"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary Source="RenderTheme.xaml"/>
    </Window.Resources>
    <DockPanel Background="{StaticResource PanelSurface}">
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardSurface}" Padding="16,12"
                BorderBrush="{StaticResource SubtleStroke}" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="Feedback" Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8" Visibility="Collapsed"/>
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" IsCancel="True" Style="{StaticResource Action}" Margin="0,0,6,0"/>
                        <Button x:Name="SaveButton" Content="Сохранить" Click="Save" Style="{StaticResource PrimaryAction}"/>
                    </StackPanel>
                    <Button x:Name="TestButton" Content="Проверить связь" Click="CheckConnection"
                        Style="{StaticResource Action}" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <Label Content="Mac по SSH" Target="{Binding ElementName=TargetBox}" FontWeight="SemiBold" Padding="0,0,0,4"/>
                <TextBox x:Name="TargetBox" MinHeight="29" Padding="6" TextChanged="FieldChanged"/>
                <TextBlock Text="Псевдоним из OpenSSH или пользователь@адрес" Style="{StaticResource SubtleText}" Margin="0,4,0,12"/>
                <Label Content="Путь к silicontrol на Mac" Target="{Binding ElementName=SilicontrolBox}" FontWeight="SemiBold" Padding="0,0,0,4"/>
                <TextBox x:Name="SilicontrolBox" MinHeight="29" Padding="6" TextChanged="FieldChanged"/>
                <Expander Header="MFLUX для правки по маске" Margin="0,14,0,0">
                    <StackPanel Margin="0,6,0,0">
                        <Label Content="Python" Target="{Binding ElementName=PythonBox}" Padding="0,4,0,4"/>
                        <TextBox x:Name="PythonBox" MinHeight="28" Padding="5" TextChanged="FieldChanged"/>
                        <Label Content="Команда редактирования изображения" Target="{Binding ElementName=CliBox}" Padding="0,8,0,4"/>
                        <TextBox x:Name="CliBox" MinHeight="28" Padding="5" TextChanged="FieldChanged"/>
                        <Label Content="Каталог модели" Target="{Binding ElementName=ModelBox}" Padding="0,8,0,4"/>
                        <TextBox x:Name="ModelBox" MinHeight="28" Padding="5" TextChanged="FieldChanged"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
