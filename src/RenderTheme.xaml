<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PanelSurface" Color="#F5F8F7" />
    <SolidColorBrush x:Key="CardSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ImageSurface" Color="#E3EBE8" />
    <SolidColorBrush x:Key="PanelText" Color="#18332F" />
    <SolidColorBrush x:Key="MutedText" Color="#46605B" />
    <SolidColorBrush x:Key="SubtleStroke" Color="#D0DDD9" />
    <SolidColorBrush x:Key="Accent" Color="#0B6253" />
    <SolidColorBrush x:Key="AccentHover" Color="#084C40" />
    <SolidColorBrush x:Key="AccentTint" Color="#DCEDE7" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelText}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SubtleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Field" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="Background" Value="{StaticResource CardSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource PanelText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SubtleStroke}"/>
    </Style>
    <Style x:Key="Action" TargetType="Button">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Foreground" Value="{StaticResource PanelText}"/>
        <Setter Property="Background" Value="{StaticResource CardSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SubtleStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TabItemStyle" TargetType="TabItem">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabChrome" CornerRadius="5" Padding="1,8" Margin="1">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource CardSurface}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource AccentTint}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PanelTabs" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource SubtleStroke}"
                                BorderThickness="0,0,0,1" Padding="6,7">
                            <UniformGrid Rows="1" IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
